classDiagram
    %% PawPal+ domain model
    %% Core flow: Owner + Pet profile -> Tasks -> Scheduler -> Plan
    %% Keep this file in sync with pawpal_system.py.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Owner {
        +str name
        +int available_minutes
        +str start_time
        +list~str~ preferences
    }

    class Pet {
        +str name
        +str species
        +list~str~ needs
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str category
        +str pet_name
        +str fixed_time
        +tuple~str~ days
        +is_fixed() bool
        +is_active_on(day_of_week) bool
    }

    class ScheduledTask {
        +Task task
        +str start_time
        +str end_time
        +str reason
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class Plan {
        +list~ScheduledTask~ scheduled
        +list~SkippedTask~ skipped
        +str explanation
        +total_minutes() int
        +summary() str
    }

    class Scheduler {
        +Owner owner
        +list~Task~ tasks
        +filter_by_recurrence(tasks, day_of_week) list~Task~
        +sort_tasks(tasks) list~Task~
        +filter_by_budget(tasks) tuple
        +assign_times(tasks) tuple
        +build_plan(day_of_week) Plan
    }

    Owner "1" --> "0..*" Pet : owns
    Owner "1" --> "0..*" Task : creates
    Task --> Pet : for (pet_name)
    Task --> Priority : has
    Scheduler --> Owner : uses
    Scheduler --> Task : schedules
    Scheduler --> Plan : produces
    Plan "1" --> "0..*" ScheduledTask : contains
    Plan "1" --> "0..*" SkippedTask : contains
    ScheduledTask --> Task : wraps
    SkippedTask --> Task : wraps