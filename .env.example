# Project-local environment variables for PawPal+
# Copy this file to .env and set your real API key.

# Optional explicit provider selection: gemini | openai | claude
# AI_PROVIDER=gemini

# Gemini setup
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI setup (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Claude setup (optional alternative)
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
